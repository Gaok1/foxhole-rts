+function sv.readFile(path)
+    local f = io.open(path, "rb")
+    if not f then return nil end
+    local size = f:seek("end")
+    if size and size > CFG.PERSIST.maxBytes then f:close(); return false end
+    f:seek("set")
+    local txt = f:read("*a")
+    f:close()
+    return txt
+end
