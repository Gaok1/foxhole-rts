+    cmp("inimigos", #enemies, #(d.enemies or {}))
+    cmp("barreiras", #structures, #(d.walls or {}))
+    cmp("trincheiras", #S.trenches, #(d.trenches or {}))
+    cmp("postos", #S.tents, #(d.tents or {}))
