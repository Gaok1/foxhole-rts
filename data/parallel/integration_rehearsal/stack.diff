+        if math.abs(diff) > E.tol then return false, "razão não fecha em " .. k end
+    end
+    if math.abs((L.bmat0 + L.refined / CFG.LOGI.ratio) - (d.bmat + L.spent)) > E.tol then return false, "razão bmat" end
