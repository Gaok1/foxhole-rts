+    -- com tudo o que a frente pede (o que for menor). Carga pendente do save sai sempre.
+    if not src and boxes < math.min(E.minLoad, math.min(wanted, CFG.LOGI.cap)) then return nil, false end
+    return cargo, src ~= nil
