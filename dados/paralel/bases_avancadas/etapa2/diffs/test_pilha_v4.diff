+def lua_slack(version, text):
+    """V4: folga real = maior numero de locais extras que o compilador ainda aceita no chunk."""
+    nl = chr(10)
+    lo, hi = 0, 250
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if compiles(version, text + nl + "local " + ",".join("__z%d" % i for i in range(mid)) + nl)[0]:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
+
