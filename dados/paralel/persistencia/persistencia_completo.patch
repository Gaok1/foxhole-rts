+    -- pela propria logi.eValid. Sem o modulo, um save que a tenha e de outra versao do mod: recusa, nao descarta.
+    if d.elogi ~= nil then
+        if not logi.eValid then return nil, "campo desconhecido: elogi (cadeia inimiga de outra versão do mod)" end
+        if d.logi == nil then return nil, "cadeia inimiga sem logística" end
+        local ok, res, why = pcall(logi.eValid, d.elogi)
+        if not ok or not res then return nil, "cadeia inimiga inválida (" .. tostring(ok and why or res) .. ")" end
+    end
+    local E = d.enemy
+    if E ~= nil then
+        if type(E) ~= "table" or d.logi == nil then return nil, "inimigo" end
+        if E.version ~= P.enemyVersion then
+            return nil, (type(E.version) == "number" and E.version > P.enemyVersion) and "inimigo de versão futura" or "inimigo versão"
+        end
+        for k in pairs(E) do
+            if k ~= "version" and k ~= "cargo" and k ~= "convoys" and k ~= "cut" then return nil, "inimigo campo " .. tostring(k) end
+        end
+        if not int(E.cargo) or E.cargo > 1000 or not int(E.convoys) or not int(E.cut) then return nil, "inimigo valores" end
+    end
+    return true
+end
